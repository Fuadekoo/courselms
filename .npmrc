# npm Security Configuration
# This file configures npm to be more secure

# Enable automatic security auditing
audit=true

# Set audit level (low, moderate, high, critical)
audit-level=moderate

# Disable funding messages (reduces noise)
fund=false

# Save exact versions (not ranges) for better security
save-exact=true

# Use package-lock.json
package-lock=true

# Prevent scripts from running during install (optional, uncomment if needed)
# ignore-scripts=false

# Use registry with integrity verification
registry=https://registry.npmjs.org/

